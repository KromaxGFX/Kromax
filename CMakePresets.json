{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KX_BUILD_EXAMPLES": "ON",
        "KX_BUILD_TESTS": "ON",
        "KX_BUILD_DRIVER_AMDGPU": "OFF"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug build",
      "description": "Debug build with full warnings"
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "Debug + ASan + UBSan",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KX_SANITIZER_ADDRESS": "ON",
        "KX_SANITIZER_UNDEFINED": "ON"
      }
    },
    {
      "name": "ci",
      "inherits": "base",
      "displayName": "CI build",
      "description": "CI preset: Debug + ASan + UBSan, examples and tests enabled",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KX_SANITIZER_ADDRESS": "ON",
        "KX_SANITIZER_UNDEFINED": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "displayName": "Build debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "displayName": "Build release"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "displayName": "Build asan-ubsan"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "displayName": "Build CI preset"
    }
  ],
  "testPresets": [
    {
      "name": "ci",
      "configurePreset": "ci",
      "displayName": "Run CI tests"
    }
  ]
}